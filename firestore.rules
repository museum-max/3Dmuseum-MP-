rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPass(data) {
      return data.keys().hasAll(['id', 'tokenId', 'ownerAddress', 'tier', 'mintTime', 'txHash']) &&
             data.keys().hasOnly(['id', 'tokenId', 'ownerAddress', 'tier', 'mintTime', 'txHash', 'network', 'tokenURI']) &&
             data.id is string && data.id.size() <= 128 &&
             data.tokenId is string && data.tokenId.size() <= 64 &&
             data.ownerAddress is string && data.ownerAddress.size() <= 64 &&
             data.tier in ['STANDARD', 'PATRON', 'CURATOR'] &&
             data.mintTime is string && data.mintTime.size() <= 64 &&
             data.txHash is string && data.txHash.size() <= 128;
    }

    function isValidExhibit(data) {
      return data.keys().hasAll(['id', 'title', 'artist', 'likesCount']) &&
             data.keys().hasOnly([
               'id', 'title', 'artist', 'description', 'imageUrl',
               'ownerAddress', 'creatorAddress', 'contractAddress', 'tokenId',
               'rarity', 'edition', 'currentBid', 'likesCount', 'bidsCount', 'updatedAt',
               'tokenURI', 'attributes'
             ]) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.artist is string && data.artist.size() <= 128 &&
             data.likesCount is number && data.likesCount >= 0;
    }

    function isValidListing(data) {
      return data.keys().hasAll(['id', 'itemId', 'title', 'itemType', 'price', 'sellerAddress', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'itemId', 'title', 'imageUrl', 'itemType', 'price', 'sellerAddress', 'buyerAddress', 'status', 'createdAt', 'soldAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.itemType in ['NFT', 'MUSEUM_PASS'] &&
             data.price is number && data.price > 0 &&
             data.sellerAddress is string && data.sellerAddress.size() <= 64 &&
             data.status in ['ACTIVE', 'SOLD', 'CANCELLED'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDeployment(data) {
      return data.keys().hasAll(['id', 'contractAddress', 'name', 'symbol', 'standard', 'deployer', 'txHash', 'deployedAt']) &&
             data.keys().hasOnly(['id', 'contractAddress', 'name', 'symbol', 'standard', 'deployer', 'txHash', 'deployedAt', 'totalSupply']) &&
             data.id is string && data.id.size() <= 128 &&
             data.contractAddress is string && data.contractAddress.size() <= 64 &&
             data.name is string && data.name.size() <= 64 &&
             data.symbol is string && data.symbol.size() <= 16 &&
             data.standard in ['ERC-721', 'ERC-1155'] &&
             data.deployer is string && data.deployer.size() <= 64 &&
             data.txHash is string && data.txHash.size() <= 128 &&
             data.deployedAt is string && data.deployedAt.size() <= 64;
    }

    function isValidGuestbook(data) {
      return data.keys().hasAll(['id', 'address', 'nickname', 'message', 'timestamp']) &&
             data.keys().hasOnly(['id', 'address', 'nickname', 'message', 'timestamp', 'passTier']) &&
             data.id is string && data.id.size() <= 128 &&
             data.address is string && data.address.size() <= 64 &&
             data.nickname is string && data.nickname.size() <= 64 &&
             data.message is string && data.message.size() <= 280 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidTx(data) {
      return data.keys().hasAll(['id', 'txHash', 'method', 'from', 'status', 'timestamp']) &&
             data.keys().hasOnly(['id', 'txHash', 'method', 'from', 'to', 'tier', 'tokenId', 'status', 'timestamp', 'gasUsed', 'blockNumber']) &&
             data.id is string && data.id.size() <= 128 &&
             data.txHash is string && data.txHash.size() <= 128 &&
             data.method is string && data.method.size() <= 64 &&
             data.from is string && data.from.size() <= 64 &&
             data.status is string && data.status.size() <= 32 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Museum Passes collection
    match /museum_passes/{passId} {
      allow read: if true;
      allow create: if isValidId(passId) && isValidPass(request.resource.data);
      allow update: if isValidId(passId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerAddress', 'txHash']) &&
        request.resource.data.ownerAddress is string &&
        request.resource.data.ownerAddress.size() <= 64;
      allow delete: if false;
    }

    // Exhibits collection
    match /exhibits/{exhibitId} {
      allow read: if true;
      allow create: if isValidId(exhibitId) && isValidExhibit(request.resource.data);
      allow update: if isValidId(exhibitId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
         request.resource.data.likesCount is number) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
         request.resource.data.likesCount is number) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'bidsCount', 'updatedAt']) &&
         request.resource.data.currentBid is number &&
         request.resource.data.bidsCount is number) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'artist', 'description', 'imageUrl', 'ownerAddress', 'updatedAt', 'tokenURI', 'attributes']) &&
         isValidExhibit(request.resource.data))
      );
      allow delete: if false;
    }

    // Marketplace Listings collection (Buy, Sell, Cancel)
    match /marketplace_listings/{listingId} {
      allow read: if true;
      allow create: if isValidId(listingId) && isValidListing(request.resource.data);
      allow update: if isValidId(listingId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyerAddress', 'soldAt']) &&
         request.resource.data.status in ['SOLD', 'CANCELLED']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price', 'status']) &&
         request.resource.data.price is number && request.resource.data.price > 0)
      );
      allow delete: if false;
    }

    // Deployed Smart Contracts on Firebase Testnet
    match /contract_deployments/{deploymentId} {
      allow read: if true;
      allow create: if isValidId(deploymentId) && isValidDeployment(request.resource.data);
      allow update, delete: if false;
    }

    // Visitor Guestbook
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidGuestbook(request.resource.data);
      allow update, delete: if false;
    }

    // Indexed Blockchain Transactions
    match /transactions/{txId} {
      allow read: if true;
      allow create: if isValidId(txId) && isValidTx(request.resource.data);
      allow update, delete: if false;
    }

    // Connection probe path
    match /test/{docId} {
      allow read: if true;
    }
  }
}
